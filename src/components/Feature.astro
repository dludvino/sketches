---
// One row in <FeatureList>. Its markdown is a paragraph and a bullet list;
// an image at the start of a bullet is that bullet's 24px icon. The tags are
// matched by their opening text only, since the dev server adds attributes
// (data-astro-source-*) after the class.
import { lazy } from '../lib/images';

interface Props {
  title: string;
  image: string;
  alt: string;
}

const { title, image, alt } = Astro.props;
const html = (await Astro.slots.render('default'))
  .replace(/<p class="case-study-section__body"/g, '<p class="case-study-feature__body"')
  .replace(/<ul class="case-study-list[^"]*"/g, '<ul class="case-study-feature__list"')
  .replace(/(<li\b[^>]*>\s*)(<img\b[^>]*>)\s*/g, (_, li, img) =>
    li + lazy(img).replace(/^<img\b/, '<img class="case-study-feature__list-icon" width="24" height="24"'),
  );
---
<article class="case-study-feature" role="listitem">
  <img loading="lazy" src={image} alt={alt} class="case-study-feature__image" />
  <div class="case-study-feature__content">
    <h4 class="case-study-feature__title">{title}</h4>
    <Fragment set:html={html} />
  </div>
</article>
