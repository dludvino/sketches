---
// The lightbox that src/js/image-modal.js opens for any image in a <figure>
// inside <main>.
---
<div id="image-modal" class="image-modal" role="dialog" aria-modal="true" aria-label="Expanded image view" aria-hidden="true">
  <button class="image-modal__close" type="button" aria-label="Close image viewer">Close</button>
  <div class="image-modal__backdrop" aria-hidden="true"></div>
  <figure class="image-modal__content">
    <img id="image-modal-image" src="" alt="" />
    <figcaption id="image-modal-caption" class="image-modal__caption"></figcaption>
  </figure>
</div>
