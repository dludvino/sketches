---
// The Sketch Book (the blog), newest first: a grid of cover-image cards.
// Posts live in posts/; see src/content.config.ts.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSketches, sketchUrl } from '../lib/pages';

const sketches = await getSketches();

// Cards fill rows of 2, 1, 3, 2, 3 in turn, then the pattern repeats. A row
// that runs out of posts shares its width among the ones left (so the last
// post alone spans the full width rather than leaving a gap).
const ROW_PATTERN = [2, 1, 3, 2, 3];
const SIZE = { 1: 'full', 2: 'half', 3: 'third' } as const;
const cards: { sketch: (typeof sketches)[number]; size: (typeof SIZE)[keyof typeof SIZE] }[] = [];
for (let i = 0, row = 0; i < sketches.length; row++) {
  const count = Math.min(ROW_PATTERN[row % ROW_PATTERN.length], sketches.length - i) as 1 | 2 | 3;
  for (const sketch of sketches.slice(i, i + count)) cards.push({ sketch, size: SIZE[count] });
  i += count;
}

// Image widths the browser picks from, per card size (the grid is at most
// --max-width, 1152px, wide).
const SIZES = {
  full: '(min-width: 1216px) 1152px, 100vw',
  half: '(min-width: 1216px) 560px, (min-width: 844px) 50vw, 100vw',
  third: '(min-width: 1216px) 363px, (min-width: 844px) 33vw, 100vw',
};
const coverWidths = (width: number) => [...[480, 800, 1200, 1800].filter((w) => w < width), Math.min(width, 2400)];
---
<BaseLayout
  title="Sketch Book"
  fullTitle="Sketch Book | Denny Ludvino"
  description="The Sketch Book by Denny Ludvino: notes, ideas, and works in progress on product design, design systems, and making things."
  ogType="website"
>
  <section class="case-study-section case-study-section--plain" aria-labelledby="sketches-title">
    <div class="container">
      <h1 id="sketches-title" class="visually-hidden">Sketch Book</h1>
      {cards.length > 0 ? (
        <ol class="sketch-grid">
          {cards.map(({ sketch, size }) => (
            <li class={`sketch-card sketch-card--${size}`}>
              <a class="sketch-card__link" href={sketchUrl(sketch)}>
                <div class="sketch-card__media">
                  {sketch.data.cover ? (
                    <Image
                      src={sketch.data.cover.src}
                      alt={sketch.data.cover.alt}
                      widths={coverWidths(sketch.data.cover.src.width)}
                      sizes={SIZES[size]}
                    />
                  ) : (
                    <img src="/assets/images/placeholder-image-wide.svg" alt="" loading="lazy" />
                  )}
                </div>
                <span class="visually-hidden">{sketch.data.title}</span>
                {sketch.data.tags.length > 0 && (
                  <ul class="card__tags card__tags--compact">
                    {sketch.data.tags.map((tag) => <li class="card__tag">{tag}</li>)}
                  </ul>
                )}
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="case-study-section__body">Nothing here yet. Check back soon.</p>
      )}
    </div>
  </section>
</BaseLayout>
